<mvc:View
    xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    controllerName="application.controller.Pedido"
    displayBlock="true"
>
    <SplitContainer
        id="SplitCont"
        initialDetail="detail"
        initialMaster="master"
        mode="ShowHideMode"
    >
        <detailPages>
            <Page
                id="detail"
                title=""
                showHeader="false"
                navButtonPress="navBack2"
                showNavButton="{device>/system/phone}"
            >
                <content>
                    <!-- KPI CLIENTES -->
                    <VBox
                        class="sapUiSmallMarginTop sapUiSmallMarginBegin sapUiSmallMarginEnd"
                    >
                        <HBox
                            justifyContent="SpaceAround"
                            alignItems="Center"
                        >
                            <GenericTag
                                text="Comprou este mês"
                                status="Success"
                                press="onFilterMesAtual"
                            >
                                <ObjectNumber
                                    number="{modelContadores>/qntEsseMes}"
                                    emphasized="true"
                                />
                            </GenericTag>

                            <GenericTag
                                text="Comprou mês passado"
                                status="Warning"
                                press="onFilterMesAnterior"
                            >
                                <ObjectNumber
                                    number="{modelContadores>/qntMesPassado}"
                                    emphasized="true"
                                />
                            </GenericTag>

                            <GenericTag
                                text="Comprou à 60 dias"
                                status="Error"
                                press="onFilter60Dias"
                            >
                                <ObjectNumber
                                    number="{modelContadores>/qnt60dias}"
                                    emphasized="true"
                                />
                            </GenericTag>
                        </HBox>
                    </VBox>

                    <!-- OBJECT HEADER -->
                    <ObjectHeader
                        id="objectHeader"
                        title="{Cliente>/Name1}"
                        number="{Cliente>/Kunnr}"
                    >
                        <statuses>
                            <ObjectStatus
                                id="objectStatus_cidade"
                                text="Cidade/Estado: {Cliente>/Ort01} {Cliente>/Regio}"
                            />
                        </statuses>
                        <attributes>
                            <ObjectAttribute
                                id="objectAttribute_cnpj"
                                text="CNPJ/CPF: {path: 'Cliente>/Stcd1', formatter:'.onFormatCnpj'} {path: 'Cliente>/Stcd2', formatter:'.onFormatCpf'}"
                            />
                        </attributes>
                    </ObjectHeader>

                    <Toolbar
                        class="sapUiMediumSmallTop"
                        id="toolbar1"
                    >
                        <ToolbarSpacer />
                        <Label
                            text="Duplicatas"
                            design="Bold"
                        />
                        <Button
                            id="idBtnDuplicatas"
                            tooltip="Títulos em aberto"
                            press="handleLinkPress"
                            icon="sap-icon://batch-payments"
                            type="Critical"
                        />
                    </Toolbar>
                </content>

                <!-- TABELA -->
                <content>
                    <Table
                        id="table_pedidos"
                        backgroundDesign="Translucent"
                        items="{ path:'Pedidos>/', sorter: { path: 'DataIniConv', descending: true }}"
                        mode="Delete"
                        delete="onExcluirPedido"
                        itemPress="onItemPress"
                        growingThreshold="99"
                        growingTriggerText="Proximos Pedidos >>"
                        growing="true"
                        noDataText="Nenhum pedido cadastrado para o cliente"
                        busyIndicatorDelay="0"
                        fixedLayout="false"
                    >
                        <headerToolbar>
                            <Toolbar>
                                <Title text="Pedidos" />
                                <ToolbarSpacer />
                                <Label text="Digitar Pedido" />
                                <Button
                                    id="idAddPedido"
                                    icon="sap-icon://add"
                                    press="onAddPedido"
                                />
                            </Toolbar>
                        </headerToolbar>

                        <!-- COLUNAS MANTIDAS -->
                        <columns>
                            <Column width="120px">
                                <Text text="Data" />
                            </Column>
                            <Column demandPopin="true">
                                <Text text="Valor total S/ST" />
                            </Column>
                            <Column demandPopin="true">
                                <Text text="Valor total C/ST" />
                            </Column>
                            <Column demandPopin="true">
                                <Text text="Pedido SAP" />
                            </Column>
                            <Column demandPopin="true" minScreenWidth="1600px">
                                <Text text="Pedido Interno" />
                            </Column>
                            <Column demandPopin="true" minScreenWidth="1600px">
                                <Text text="Aprovador" />
                            </Column>
                            <Column demandPopin="true">
                                <Text text="Total cxs" />
                            </Column>
                            <Column demandPopin="true">
                                <Text text="Valor verba" />
                            </Column>
                            <Column
                                width="120px"
                                hAlign="Center"
                            >
                                <Text
                                    text="Rentab. %"
                                    textDirection="LTR"
                                />
                            </Column>
                            <Column width="80px">
                                <Text text="Rentab" />
                            </Column>
                            <Column width="auto">
                                <Text text="Status" />
                            </Column>
                        </columns>

                        <!-- ITEMS MANTIDOS -->
                        <items>
                            <ColumnListItem
                                type="DetailAndActive"
                                detailPress="onEditarPress"
                            >
                                <cells>
                                    <Text
                                        text="{path : 'Pedidos>DataFim', formatter:'.myFormatterData'} - {path : 'Pedidos>HoraFim', formatter:'.myFormatterHora'}"
                                    />

                                    <Text
                                        text="R$: {path : 'Pedidos>ValorTotal', type: 'sap.ui.model.type.Float', formatOptions: { groupingEnabled: true, groupingSeparator: '.', decimalSeparator: ',', maxFractionDigits: 2, minFractionDigits: 2 }}"
                                    />

                                    <Text
                                        text="R$: {path : 'Pedidos>ValTotItemSt', type: 'sap.ui.model.type.Float', formatOptions: { groupingEnabled: true, groupingSeparator: '.', decimalSeparator: ',', maxFractionDigits: 2, minFractionDigits: 2 }}"
                                    />

                                    <Text text="{Pedidos>Vbeln}" />

                                    <Text
                                        text="{Pedidos>Lifnr} - {Pedidos>NrPedido}"
                                    />
                                    <Text text="{Pedidos>UsuarioEnvio}" />

                                    <Text text="{Pedidos>TotalItens}" />

                                    <Text text="R$: {path: 'Pedidos>TotalVerba', type: 'sap.ui.model.type.Float', formatOptions: { groupingEnabled: true, groupingSeparator: '.', decimalSeparator: ',', maxFractionDigits: 2, minFractionDigits: 2 }}" />
                                    <!-- formatter: '.formatRentabilidade' -->
                                    <ObjectListItem
                                        number="{path: 'Pedidos>RentTotal', type: 'sap.ui.model.type.Float', formatOptions: { groupingEnabled: true, groupingSeparator: '.', decimalSeparator: ',', maxFractionDigits: 2, minFractionDigits: 2 }}"
                                        numberState="{= ${Pedidos>RentTotal} >= 0 ? 'Success' : 'Error' }"
                                    />

                                    <Image
                                        src="{Pedidos>RentTotalImg}"
                                        width="40%"
                                    />

                                    <ObjectStatus
                                        text="{Pedidos>SituacaoPedido}"
                                        icon="{
                                            path:'Pedidos>IdStatusPedido',
                                            formatter:'.formatterStatusIcon'
                                        }"
                                        state="{
                                            path:'Pedidos>IdStatusPedido',
                                            formatter:'.formatterStatusState'
                                        }"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Page>
        </detailPages>

        <!-- MASTER MANTIDO ORIGINAL -->
        <masterPages>
            <Page
                id="master"
                title="Clientes"
                class="sapUiStdPage"
                showNavButton="true"
                navButtonPress="onNavBack"
            >
                <subHeader>
                    <Toolbar>
                        <SearchField
                            width="100%"
                            liveChange="onSearch"
                            search="onSearch"
                            placeholder="Pesquisar"
                        />
                    </Toolbar>
                </subHeader>

                <content>
                    <List
                        id="listClientes"
                        items="{ path: 'Clientes>/' }"
                        mode="SingleSelectMaster"
                        growing="true"
                        selectionChange="onSelectionChange"
                    >
                        <items>
                            <ObjectListItem
                                type="Active"
                                press="onSelectionChange"
                                title="{Clientes>Name1}"
                                number="{Clientes>Kunnr}"
                            >
                                <customData>
                                    <core:CustomData
                                        key="mydataClientes"
                                        value="{path: 'Clientes>IdCorGrid', type: 'sap.ui.model.type.String'}"
                                        writeToDom="true"
                                    />
                                </customData>
                                <ObjectAttribute
                                    text="Repres: {Clientes>Lifnr}"
                                />
                                <firstStatus>
                                    <ObjectStatus
                                        text="{Clientes>Ort01}-{Clientes>Regio}"
                                    />
                                </firstStatus>
                                <secondStatus>
                                    <ObjectStatus
                                        text="CNPJ: {path: 'Clientes>Stcd1', formatter:'.onFormatCnpj'}"
                                    />
                                </secondStatus>
                            </ObjectListItem>
                        </items>
                    </List>
                </content>

                <footer>
                    <Bar>
                        <contentRight>
                            <Button
                                text="Atualizar"
                                icon="sap-icon://refresh"
                                type="Emphasized"
                                press="_onLoadFields"
                            />
                        </contentRight>
                    </Bar>
                </footer>
            </Page>
        </masterPages>
    </SplitContainer>
</mvc:View>
