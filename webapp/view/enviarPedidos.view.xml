<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:semantic="sap.m.semantic"
    height="100%"
    controllerName="application.controller.enviarPedidos"
>
    <Page
        id="master"
        navButtonPress="onNavBack"
        showNavButton="true"
        title="Envio de Pedidos"
        busyIndicatorDelay="0"
    >
        <content>
            <!--itemPress="onItemPress" -->
            <Table
                id="table_pedidos"
                itemPress="onItemPress"
                width="100%"
                backgroundDesign="Translucent"
                items="{ path:'Pedidos>/', sorter: { path: 'NrPedido', descending: true}}"
                mode="MultiSelect"
                selectionChange="onSelectionChange"
                growingThreshold="6"
                growingTriggerText="Proximos Pedidos &gt;&gt;"
                growing="true"
                noDataText="Nenhum pedido pendente para envio"
                busyIndicatorDelay="0"
                fixedLayout="false"
                footerText="Valor total dos pendidos pendentes R$: {path: 'modelAux>/ValTotPedPend', type: 'sap.ui.model.type.Float', formatOptions: {milharSeparetor: '.', decimalSeparator: ',', maxFractionDigits: 2, minFractionDigits : 2 }, constraints : { minimum: '0', maximum: '99' }}"
            >
                <headerToolbar>
                    <Toolbar>
                        <Title text="Pedidos de Venda" />
                        <ToolbarSpacer />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column
                        minScreenWidth="320px"
                        demandPopin="true"
                        popinDisplay="Inline"
                        hAlign="Left"
                        width="auto"
                    >
                        <Text text="Empresa" />
                    </Column>
                    <Column
                        minScreenWidth="320px"
                        demandPopin="true"
                        popinDisplay="Inline"
                        hAlign="Left"
                    >
                        <Text text="Cliente" />
                    </Column>
                    <Column
                        minScreenWidth="800px"
                        demandPopin="true"
                        popinDisplay="Inline"
                    >
                        <Text text="Pedido Interno" />
                    </Column>
                    <Column
                        minScreenWidth="550px"
                        demandPopin="true"
                        popinDisplay="Inline"
                        hAlign="Left"
                    >
                        <Text text="Verba" />
                    </Column>
                    <Column
                        minScreenWidth="550px"
                        demandPopin="true"
                        popinDisplay="Inline"
                        hAlign="Left"
                    >
                        <Text text="Data" />
                    </Column>
                    <Column
                        minScreenWidth="320px"
                        demandPopin="true"
                        popinDisplay="Inline"
                        hAlign="Left"
                    >
                        <Text text="V. Total" />
                    </Column>
                    <Column
                        width="120px"
                        hAlign="Center"
                    >
                        <Text
                            text="Rentab. %"
                            textDirection="LTR"
                        />
                    </Column>
                    <Column width="80px">
                        <Text text="Rentab" />
                    </Column>
                    <Column width="auto">
                        <Text text="Status" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Active">
                        <cells>
                            <Text
                                text="{Pedidos>Bukrs} - {Pedidos>Werks} - {Pedidos>WerksDesc}"
                            />
                            <!-- text="{path : 'Pedidos>Bukrs', formatter:'.myFormatterCodEmpresa'}" -->
                            <Text
                                text="{Pedidos>Kunnr} - {Pedidos>KunnrDesc}"
                            />
                            <!-- text="{path : 'Pedidos>Kunnr', formatter:'.myFormatterCliente'}" -->
                            <Text text="{Pedidos>Lifnr} - {Pedidos>NrPedido}" />
                            <Text
                                text="R$: {path : 'Pedidos>TotalVerba', type: 'sap.ui.model.type.Float', formatOptions: {milharSeparetor: '.', decimalSeparator: ',', maxFractionDigits: 2, minFractionDigits : 2 }, constraints : { minimum: '0', maximum: '99' }}"
                            />
                            <Text
                                text="{path : 'Pedidos>DataFim'} - {path : 'Pedidos>HoraFim'}"
                            />
                            <Text
                                text="R$: {path : 'Pedidos>ValorTotal', type: 'sap.ui.model.type.Float', formatOptions: {milharSeparetor: '.', decimalSeparator: ',', maxFractionDigits: 2, minFractionDigits : 2 }, constraints : { minimum: '0', maximum: '99' }}"
                            />

                            <ObjectListItem
                                number="{path: 'Pedidos>RentTotal'}"
                                numberState="{= ${Pedidos>RentTotal} >= 0 ? 'Success' : 'Error' }"
                            />

                            <Image
                                src="{Pedidos>RentTotalImg}"
                                width="40%"
                            />

                            <ObjectStatus
                                text="{Pedidos>SituacaoPedido}"
                                icon="{
                                            path:'Pedidos>IdStatusPedido',
                                            formatter:'.formatterStatusIcon'
                                        }"
                                state="{
                                            path:'Pedidos>IdStatusPedido',
                                            formatter:'.formatterStatusState'
                                        }"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <footer>
            <Bar id="bar0">
                <contentRight>
                    <Button
                        xmlns:mvc="sap.ui.core.mvc"
                        xmlns:core="sap.ui.core"
                        xmlns:form="sap.ui.layout.form"
                        xmlns:semantic="sap.m.semantic"
                        xmlns="sap.m"
                        text="Enviar"
                        press="onEnviarPedido"
                        icon="sap-icon://upload"
                        type="Accept"
                        id="btnEnviarPedido"
                    />
                    <Button
                        xmlns:mvc="sap.ui.core.mvc"
                        xmlns:core="sap.ui.core"
                        xmlns:form="sap.ui.layout.form"
                        xmlns:semantic="sap.m.semantic"
                        xmlns="sap.m"
                        text="Excluir"
                        press="onDeletarPedido"
                        icon="sap-icon://delete"
                        type="Reject"
                        id="btnExcluirPedido"
                    />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
