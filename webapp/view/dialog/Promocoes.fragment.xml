<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
>
    <Dialog
        id="dlgAnexos"
        title="Promoções disponíveis"
        contentWidth="18%"
        contentHeight="100%"
        beforeClose=".onBeforeCloseAnexosDialog"
        escapeHandler=".onEscapeAnexosDialog"
        resizable="true"
        draggable="true"
        horizontalScrolling="true"
        verticalScrolling="true"
        initialFocus="idBtnCancel"
    >
        <VBox
            class="sapUiContentPadding"
            width="100%"
            height="100%"
        >
            <Carousel
                id="carAnexos"
                loop="true"
                pages="{modelCarousel>/items}"
                pageChanged=".onAnexosCarouselPageChanged"
                showPageIndicator="false"
            >
                <pages>
                    <VBox
                        width="100%"
                        height="100%"
                        alignItems="Center"
                        justifyContent="Center"
                    >
                        <!-- alt="{modelCarousel>fileName}" -->
                        <Image
                            src="{modelCarousel>src}"
                            width="100%"
                            height="90%"
                            densityAware="false"
                        />
                        <!-- <Text
                            class="sapUiTinyMarginTop"
                            text="{modelCarousel>fileName}"
                        /> -->
                        <tnt:InfoLabel
                            id="il2"
                            text="Para fechar,"
                            renderMode="Narrow"
                            colorScheme="2"
                        />
                        <tnt:InfoLabel
                            id="il3"
                            text="passe por todas as lâminas."
                            renderMode="Narrow"
                            colorScheme="2"
                        />
                        <Text
                            class="sapUiTinyMarginTop"
                            text="{= 'Vistos: ' + ${modelCarousel>/visitedCount} + ' / ' + ${modelCarousel>/total} }"
                        />
                    </VBox>
                </pages>
            </Carousel>
        </VBox>
        <endButton>
            <Button
                id="idBtnCancel"
                text="Fechar"
                enabled="true"
                press=".onCloseAnexosDialog"
            />
                <!-- enabled="{modelCarousel>/canClose}" -->
        </endButton>
    </Dialog>
</core:FragmentDefinition>
