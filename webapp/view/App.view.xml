<mvc:View
    controllerName="application.controller.App"
    displayBlock="false"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:mvc="sap.ui.core.mvc"
>
    <u:Shell
        headerHiding="false"
        headerVisible="true"
        id="MyShell"
        icon=""
    >
        <!--{modelAux>/iconeEmpresa}-->
        <u:headItems>
            <u:ShellHeadItem
                id="label"
                tooltip="Home"
                icon="sap-icon://home"
                press="handlePressHome"
            />
            <!--visible="{modelAux>/homeVisible}"-->
        </u:headItems>
        <u:headItems>
            <u:ShellHeadItem
                tooltip="Versão"
                icon="sap-icon://hint"
                press="showVersion"
            />
            <!--visible="{modelAux>/homeVisible}"-->
        </u:headItems>
        <u:user>
            <u:ShellHeadUserItem
                id="shellHeadUser"
                image="sap-icon://customer"
                username="{modelAux>/CodRepres}-{modelAux>/NomeRepres}"
                press="showId"
            />
        </u:user>
        <u:headEndItems>
            <u:ShellHeadItem
                id="idLogoff"
                icon="sap-icon://log"
                tooltip="Logoff"
                press="handleLogoffPress"
            />
        </u:headEndItems>
        <u:content>
            <App
                id="app"
            />
        </u:content>
    </u:Shell>
</mvc:View>
