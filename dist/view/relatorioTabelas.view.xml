<mvc:View height="100%" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:form="sap.ui.layout.form" controllerName="application.controller.relatorioTabelas">
    <Page id="relatorioTabelasPage" title="Tabelas de preço" showNavButton="true" navButtonPress="onNavBack" class="sapUiSizeCompact">
        <content>
            <VBox class="sapUiResponsiveMargin" busy="{= ${modelEstado>/Carregando} || ${modelEstado>/Cliente} }" busyIndicatorDelay="0">
                <Title text="Consultar preços" level="H2"/>
                <Text text="Selecione o centro e consulte o cliente para carregar suas condições comerciais." class="sapUiTinyMarginTop sapUiSmallMarginBottom"/>
                <Panel headerText="Filtros e condições comerciais" backgroundDesign="Solid">
                    <content>
                        <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                            <form:content>
                                <core:Title text="Cliente e origem"/>
                                <Label text="Centro" required="true" labelFor="idEstabelecimento"/>
                                <Select id="idEstabelecimento" width="100%" forceSelection="false" selectedKey="{modelTela>/Werks}" items="{modelCentros>/}" change="onChangeEstabelecimento"><core:Item key="{modelCentros>Werks}" text="{modelCentros>NomeCentro}"/></Select>
                                <Label text="UF de origem" labelFor="idUFOrigem"/>
                                <Text id="idUFOrigem" text="{modelTela>/UFOrigem}"/>
                                <Label text="Cliente" required="true" labelFor="idCliente"/>
                                <SearchField id="idCliente" width="100%" placeholder="Código do cliente" value="{modelTela>/Kunnr}" enableSuggestions="true" search="onChangeCliente" liveChange="onClienteLiveChange" suggest="_handleValueHelpSearch" suggestionItems="{path: 'modelClientes>/', sorter: {path: 'Kunnr'}}" enabled="{= !!${modelTela>/Werks} }"><suggestionItems><SuggestionItem key="{modelClientes>Kunnr}" text="{modelClientes>Kunnr}" description="{modelClientes>Name1}"/></suggestionItems></SearchField>
                                <Label text="Nome do cliente"/>
                                <Text text="{modelTela>/Name1}" wrapping="true"/>
                                <Label text="UF de destino" labelFor="idUFDestino"/>
                                <Text id="idUFDestino" text="{modelTela>/UFDestino}"/>
                                <Label text="Canal de atuação" labelFor="idKvgr2"/>
                                <Text id="idKvgr2" text="{modelTela>/DescKvgr2}" wrapping="true"/>
                                <core:Title text="Preço e entrega"/>
                                <Label text="Tabela de preço" required="true" labelFor="idTabelaPreco"/>
                                <Select id="idTabelaPreco" width="100%" forceSelection="false" selectedKey="{modelTela>/Pltyp}" items="{modelTbPreco>/}" change="onChangeTabelaPreco"><core:Item key="{modelTbPreco>Pltyp}" text="{modelTbPreco>Pltyp} - {modelTbPreco>Ptext}"/></Select>
                                <Label text="Vencimento" required="true" labelFor="idVencimento"/>
                                <Select id="idVencimento" width="100%" forceSelection="false" selectedKey="{modelTela>/Vencimento}" enabled="{= !${modelEstado>/ContratoFixo} }" items="{path: 'modelVencimentos>/', sorter: {path: 'Zterm'}}" change="onChangeVencimento"><core:Item key="{modelVencimentos>Zterm}" text="{modelVencimentos>DescCond}"/></Select>
                                <Label id="idLabelContrato" text="Contrato" visible="{= !!${modelTela>/Contrato} }"/>
                                <Text id="idContrato" text="{modelTela>/Contrato}" visible="{= !!${modelTela>/Contrato} }"/>
                                <Label text="Índice" labelFor="idIndice"/>
                                <ObjectNumber id="idIndice" number="{path: 'modelTela>/Indice', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2, decimalSeparator: ','}}" unit="%" emphasized="false"/>
                                <Label text="Tipo de transporte" required="true" labelFor="idTipoTransporte"/>
                                <Select id="idTipoTransporte" width="100%" forceSelection="false" selectedKey="{modelTela>/Inco1}" items="{modelFretes>/}" change="onChangeTipoFrete"><core:Item key="{modelFretes>Inco1}" text="{modelFretes>Inco1} - {modelFretes>Bezei}"/></Select>
                                <Label text="Exibir preços por" labelFor="idExibicao"/>
                                <Select id="idExibicao" width="100%" selectedKey="{modelTela>/Exibicao}" items="{ComboExibicao>/}"><core:Item key="{ComboExibicao>idExibicao}" text="{ComboExibicao>descricao}"/></Select>
                            </form:content>
                        </form:SimpleForm>
                    </content>
                </Panel>
            </VBox>
        </content>
        <footer><OverflowToolbar><ToolbarSpacer/><Button id="idLoadTabelaPreco" text="Consultar preços" icon="sap-icon://search" type="Emphasized" press="onCarregarPrecos" enabled="{= !${modelEstado>/Carregando} &amp;&amp; !${modelEstado>/Cliente} }"/></OverflowToolbar></footer>
    </Page>
</mvc:View>
